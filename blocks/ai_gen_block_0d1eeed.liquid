{% doc %}
  @prompt
    Create a collections grid section that displays 2 rows of 3 collections on desktop (6 collections total in a 3-column grid) and 3 rows of 2 collections on mobile (6 collections total in a 2-column grid). The section should be responsive and allow merchants to select which collections to display. Include collection images, titles, and links to each collection page., allow the collection image to be the first product or have the ability to choose a different image
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collections-grid-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-collections-grid-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-collections-grid-heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-collections-grid-wrapper-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-collection-card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    transition: transform 0.3s ease;
  }

  .ai-collection-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-collection-card-link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ai-collection-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background-color: {{ block.settings.image_background_color }};
  }

  .ai-collection-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.image_background_color }};
  }

  .ai-collection-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,{{ block.settings.overlay_opacity | divided_by: 100.0 }}) 100%);
  }

  .ai-collection-content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
    text-align: {{ block.settings.text_alignment }};
    background-color: {{ block.settings.card_background_color }};
  }

  .ai-collection-title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    font-weight: 600;
  }

  .ai-collection-count-{{ ai_gen_id }} {
    margin-top: 8px;
    font-size: {{ block.settings.count_size }}px;
    color: {{ block.settings.count_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-collections-grid-wrapper-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.grid_gap_mobile }}px;
    }

    .ai-collections-grid-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-collection-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .ai-collection-count-{{ ai_gen_id }} {
      font-size: {{ block.settings.count_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-collections-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collections-grid-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-collections-grid-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-collections-grid-wrapper-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign custom_image_key = 'collection_' | append: i | append: '_custom_image'
          assign collection = block.settings[collection_key]
          assign custom_image = block.settings[custom_image_key]
        %}

        {% if collection != blank %}
          <div class="ai-collection-card-{{ ai_gen_id }}">
            <a href="{{ collection.url }}" class="ai-collection-card-link-{{ ai_gen_id }}">
              <div class="ai-collection-image-wrapper-{{ ai_gen_id }}">
                {% liquid
                  assign display_image = null
                  
                  if custom_image != blank
                    assign display_image = custom_image
                  elsif block.settings.image_source == 'first_product' and collection.products.first.featured_image
                    assign display_image = collection.products.first.featured_image
                  elsif collection.featured_image
                    assign display_image = collection.featured_image
                  elsif block.settings.image_source == 'first_product' and collection.products.first.featured_image
                    assign display_image = collection.products.first.featured_image
                  endif
                %}

                {% if display_image %}
                  <img
                    src="{{ display_image | image_url: width: 800 }}"
                    alt="{{ display_image.alt | default: collection.title | escape }}"
                    width="800"
                    height="{{ 800 | times: block.settings.image_aspect_ratio | divided_by: 100.0 | round }}"
                    loading="lazy"
                    class="ai-collection-image-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-collection-placeholder-{{ ai_gen_id }}">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
                {% if block.settings.show_overlay %}
                  <div class="ai-collection-overlay-{{ ai_gen_id }}"></div>
                {% endif %}
              </div>

              <div class="ai-collection-content-{{ ai_gen_id }}">
                <h3 class="ai-collection-title-{{ ai_gen_id }}">{{ collection.title }}</h3>
                {% if block.settings.show_product_count %}
                  <p class="ai-collection-count-{{ ai_gen_id }}">
                    {{ collection.products_count }}
                    {% if collection.products_count == 1 %}
                      product
                    {% else %}
                      products
                    {% endif %}
                  </p>
                {% endif %}
              </div>
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

