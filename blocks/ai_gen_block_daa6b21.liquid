{% doc %}
  @prompt
    Create a new Shopify theme section for collection pages called "Collection Hero Header". It should contain the following elements stacked vertically in this exact order:
    
    1. BREADCRUMB — Auto-generated, simple. Format: "Home > [Collection Title]". Small font, muted/grey colour, links back to homepage. Keep it minimal.
    
    2. H1 COLLECTION HEADING — Display the collection.title as an H1. Should be prominent but match the existing theme's heading style.
    
    3. PILL-STYLE BULLET POINTS — Pull from the collection metafield `custom.bullet_point_for_header`. Display each bullet point as a styled pill/tag (rounded, subtle background that matches the current theme's colour palette — not loud). Pills should sit in a horizontal wrapping row. Each pill should have a small icon or dot prefix. Mobile-friendly wrapping.
    
    4. SEO GRAB LINE — Pull from the collection metafield `custom.seo_grab_line`. Display as a short paragraph directly below the pills. Slightly smaller than the H1, readable body font, neutral colour. This line should be written in plain natural language so it is easily readable and indexable by LLMs like ChatGPT and Google SGE — no keyword stuffing, just clear descriptive prose.
    
    Design requirements:
    - Clean, minimal, premium feel — no heavy borders or backgrounds on the section itself
    - Left-aligned layout
    - Tight but breathable spacing between each element
    - Mobile optimised — no overflow or wrapping issues
    - The section should be structured with proper semantic HTML (nav for breadcrumb, h1 for heading, p for SEO line) to maximise LLM and search engine readability
    - Use schema settings so the section can be toggled or adjusted in the theme customiser, the h1 heading letter spacing needs to be able to be changed, for the collection metafields please make sure we remove any [""], on mobile can we scale the font of the bullet points even smaller so they are 2 wide and can overlap down to a second line if needed
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign hero_image = block.settings.hero_image | default: collection.image
  assign has_hero = false
  if block.settings.enable_hero_image and hero_image != blank and collection != blank
    assign has_hero = true
  endif
%}

{% style %}
  .ai-collection-hero-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-collection-hero__container-{{ ai_gen_id }} {
    max-width: {{ settings.page_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  {% if has_hero %}
  .ai-collection-hero-{{ ai_gen_id }}.ai-collection-hero--has-media-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: {{ block.settings.hero_height }}px;
  }

  .ai-collection-hero__media-{{ ai_gen_id }},
  .ai-collection-hero__overlay-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
  }

  .ai-collection-hero__media-{{ ai_gen_id }} {
    z-index: 0;
    overflow: hidden;
  }

  .ai-collection-hero__media-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness({{ block.settings.hero_image_brightness }}%);
  }

  .ai-collection-hero__overlay-{{ ai_gen_id }} {
    z-index: 1;
    background-color: {{ block.settings.hero_overlay_color }};
    opacity: {{ block.settings.hero_overlay_opacity | divided_by: 100.0 }};
  }

  .ai-collection-hero--has-media-{{ ai_gen_id }} .ai-collection-hero__container-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    width: 100%;
  }
  {% endif %}

  .ai-collection-hero__breadcrumb-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.breadcrumb_spacing }}px;
  }

  .ai-collection-hero__breadcrumb-nav-{{ ai_gen_id }} {
    font-size: {{ block.settings.breadcrumb_font_size }}px;
    color: {{ block.settings.breadcrumb_color }};
    line-height: 1.5;
  }

  .ai-collection-hero__breadcrumb-link-{{ ai_gen_id }} {
    color: {{ block.settings.breadcrumb_color }};
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .ai-collection-hero__breadcrumb-link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-collection-hero__breadcrumb-separator-{{ ai_gen_id }} {
    margin: 0 8px;
    opacity: 0.5;
  }

  .ai-collection-hero__breadcrumb-current-{{ ai_gen_id }} {
    color: {{ block.settings.breadcrumb_color }};
    opacity: 0.6;
  }

  .ai-collection-hero__heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-size: {{ block.settings.heading_font_size }}px;
    color: {{ block.settings.heading_color }};
    font-weight: 700;
    line-height: {{ settings.type_header_line_height }};
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    {% if settings.type_header_capitalize %}
      text-transform: uppercase;
    {% endif %}
  }

  .ai-collection-hero__pills-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.pill_gap }}px;
    margin-bottom: {{ block.settings.pills_spacing }}px;
  }

  .ai-collection-hero__pill-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: {{ block.settings.pill_padding_vertical }}px {{ block.settings.pill_padding_horizontal }}px;
    background-color: {{ block.settings.pill_background }};
    color: {{ block.settings.pill_text_color }};
    border-radius: {{ block.settings.pill_border_radius }}px;
    font-size: {{ block.settings.pill_font_size }}px;
    line-height: 1.4;
    font-weight: 500;
  }

  .ai-collection-hero__pill-icon-{{ ai_gen_id }} {
    width: {{ block.settings.pill_icon_size }}px;
    height: {{ block.settings.pill_icon_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.pill_icon_color }};
    flex-shrink: 0;
  }

  .ai-collection-hero__seo-text-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.seo_font_size }}px;
    color: {{ block.settings.seo_text_color }};
    line-height: 1.6;
    max-width: {{ block.settings.seo_max_width }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-hero__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_font_size | times: 0.7 }}px;
    }

    .ai-collection-hero__breadcrumb-nav-{{ ai_gen_id }} {
      font-size: {{ block.settings.breadcrumb_font_size | times: 0.9 }}px;
    }

    .ai-collection-hero__pills-{{ ai_gen_id }} {
      gap: {{ block.settings.pill_gap | times: 0.7 }}px;
    }

    .ai-collection-hero__pill-{{ ai_gen_id }} {
      font-size: {{ block.settings.pill_font_size | times: 0.7 }}px;
      padding: {{ block.settings.pill_padding_vertical | times: 0.7 }}px {{ block.settings.pill_padding_horizontal | times: 0.7 }}px;
      flex: 0 0 calc(50% - {{ block.settings.pill_gap | times: 0.35 }}px);
      max-width: calc(50% - {{ block.settings.pill_gap | times: 0.35 }}px);
    }

    .ai-collection-hero__pill-icon-{{ ai_gen_id }} {
      width: {{ block.settings.pill_icon_size | times: 0.7 }}px;
      height: {{ block.settings.pill_icon_size | times: 0.7 }}px;
    }

    .ai-collection-hero__seo-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.seo_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<collection-hero-{{ ai_gen_id }} class="ai-collection-hero-{{ ai_gen_id }}{% if has_hero %} ai-collection-hero--has-media-{{ ai_gen_id }}{% endif %}" {{ block.shopify_attributes }}>
  {% if has_hero %}
    <div class="ai-collection-hero__media-{{ ai_gen_id }}">
      {{ hero_image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '600, 900, 1200, 1600, 2000', alt: '' }}
    </div>
    <div class="ai-collection-hero__overlay-{{ ai_gen_id }}" aria-hidden="true"></div>
  {% endif %}
  <div class="ai-collection-hero__container-{{ ai_gen_id }}">
    {% if block.settings.show_breadcrumb and collection != blank %}
      <div class="ai-collection-hero__breadcrumb-{{ ai_gen_id }}">
        <nav class="ai-collection-hero__breadcrumb-nav-{{ ai_gen_id }}" aria-label="Breadcrumb">
          <a href="/" class="ai-collection-hero__breadcrumb-link-{{ ai_gen_id }}">Home</a>
          <span class="ai-collection-hero__breadcrumb-separator-{{ ai_gen_id }}" aria-hidden="true">></span>
          <span class="ai-collection-hero__breadcrumb-current-{{ ai_gen_id }}">{{ collection.title }}</span>
        </nav>
      </div>
    {% endif %}

    {% if block.settings.show_heading and collection != blank %}
      <h1 class="ai-collection-hero__heading-{{ ai_gen_id }}">
        {{ collection.title }}
      </h1>
    {% endif %}

    {% if block.settings.show_pills and collection.metafields.custom.bullet_point_for_header != blank %}
      {% assign raw_metafield = collection.metafields.custom.bullet_point_for_header %}
      {% assign cleaned_metafield = raw_metafield | remove: '["' | remove: '"]' | remove: '"' %}
      {% assign bullet_points = cleaned_metafield | split: ',' %}
      {% if bullet_points.size > 0 %}
        <div class="ai-collection-hero__pills-{{ ai_gen_id }}">
          {% for point in bullet_points %}
            {% assign trimmed_point = point | strip %}
            {% if trimmed_point != blank %}
              <span class="ai-collection-hero__pill-{{ ai_gen_id }}">
                <span class="ai-collection-hero__pill-icon-{{ ai_gen_id }}" aria-hidden="true"></span>
                {{ trimmed_point }}
              </span>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}

    {% if block.settings.show_seo_line and collection.metafields.custom.seo_grab_line != blank %}
      {% assign raw_seo = collection.metafields.custom.seo_grab_line %}
      {% assign cleaned_seo = raw_seo | remove: '["' | remove: '"]' | remove: '"' %}
      <p class="ai-collection-hero__seo-text-{{ ai_gen_id }}">
        {{ cleaned_seo }}
      </p>
    {% endif %}
  </div>
</collection-hero-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Collection hero header",
  "settings": [
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show collection title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pills",
      "label": "Show bullet points",
      "default": true,
      "info": "Pulls from collection.metafields.custom.bullet_point_for_header (comma-separated)"
    },
    {
      "type": "checkbox",
      "id": "show_seo_line",
      "label": "Show SEO description",
      "default": true,
      "info": "Pulls from collection.metafields.custom.seo_grab_line"
    },
    {
      "type": "header",
      "content": "Hero image"
    },
    {
      "type": "checkbox",
      "id": "enable_hero_image",
      "label": "Use a background hero image",
      "default": false,
      "info": "Uses the collection's featured image by default. Set light text colours below so the heading, breadcrumb and SEO text stay readable."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Image override",
      "info": "Optional. Falls back to the collection's featured image."
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "Minimum height",
      "min": 160,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 360
    },
    {
      "type": "color",
      "id": "hero_overlay_color",
      "label": "Overlay colour",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "hero_overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "range",
      "id": "hero_image_brightness",
      "label": "Image brightness",
      "min": 20,
      "max": 130,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "breadcrumb_spacing",
      "label": "Breadcrumb bottom spacing",
      "min": 5,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Heading bottom spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "pills_spacing",
      "label": "Pills bottom spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Breadcrumb style"
    },
    {
      "type": "range",
      "id": "breadcrumb_font_size",
      "label": "Font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "color",
      "id": "breadcrumb_color",
      "label": "Color",
      "default": "#737373"
    },
    {
      "type": "header",
      "content": "Heading style"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Font size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Letter spacing",
      "min": -5,
      "max": 10,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color",
      "default": "#171717"
    },
    {
      "type": "header",
      "content": "Pills style"
    },
    {
      "type": "range",
      "id": "pill_font_size",
      "label": "Font size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "pill_padding_vertical",
      "label": "Vertical padding",
      "min": 4,
      "max": 16,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "pill_padding_horizontal",
      "label": "Horizontal padding",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "pill_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "pill_gap",
      "label": "Gap between pills",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "pill_background",
      "label": "Background color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "pill_text_color",
      "label": "Text color",
      "default": "#171717"
    },
    {
      "type": "range",
      "id": "pill_icon_size",
      "label": "Icon size",
      "min": 4,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "color",
      "id": "pill_icon_color",
      "label": "Icon color",
      "default": "#0097b2"
    },
    {
      "type": "header",
      "content": "SEO description style"
    },
    {
      "type": "range",
      "id": "seo_font_size",
      "label": "Font size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "seo_text_color",
      "label": "Color",
      "default": "#525252"
    },
    {
      "type": "range",
      "id": "seo_max_width",
      "label": "Maximum width",
      "min": 400,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "default": 800
    }
  ],
  "presets": [
    {
      "name": "Collection hero header"
    }
  ]
}
{% endschema %}
