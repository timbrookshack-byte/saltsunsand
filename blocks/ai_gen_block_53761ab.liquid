{% doc %}
  @prompt
    Create a new Shopify theme section called "Conversion Stack" (or "Product Trust Badges") to be used on product pages. The section should display 4–5 editable benefit points in a vertical stack, designed to sit directly below the product price and stock status to boost trust and conversion.
    
    Requirements:
    - Display 4–5 benefit rows, each with a small icon (emoji or SVG) and a short bold benefit statement (max 6–8 words)
    - Layout: clean, minimal, left-aligned, compact spacing between rows
    - Font size slightly smaller than the product title but clearly readable
    - Neutral/dark text colour, no borders or heavy backgrounds (premium/minimal look)
    - Icons aligned left with text on the same row
    - Max width aligned with the product content column
    - Fully mobile-optimised: no wrapping issues, good spacing and readability
    
    Each benefit row must be fully editable in the Shopify theme customiser (icon/emoji and benefit text separately), so the section can be reused across different products.
    
    Default example content:
    1. ⭐ 4.8 average rating from Aussie customers
    2. ☀️ UV & weather resistant fabric
    3. 🚚 Fast dispatch from Brisbane warehouse
    4. 🔁 30-day easy returns
    
    The section should be named "Conversion Stack" or "Product Trust Badges" and be designed to slot into the product page template directly below the price block., Update the “Conversion Stack” section so that it aligns with the same content width and left margin as the rest of the product page.
    
    Requirements:
    
    The section must be wrapped in the same container class used by the product content (e.g. .page-width, .container, or equivalent in this theme).
    The content should NOT span full width — it must align perfectly with:
    Product title
    Price
    Add to cart button
    Apply consistent horizontal padding:
    Desktop: match theme spacing (usually 24px–40px)
    Mobile: match theme spacing (usually 16px–20px)
    Ensure the left edge of the conversion stack lines up exactly with the product text content above and below it.
    Do NOT use custom margins to fake alignment — inherit the theme’s layout system.
    Keep the section visually consistent with the theme (Concept):
    Same max-width
    Same gutter spacing
    Same alignment rules
    If needed, inspect surrounding product sections and reuse the same wrapper structure.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-badges-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .ai-trust-badges__list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.row_spacing }}px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-trust-badges__item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.icon_spacing }}px;
    margin: 0;
    padding: 0;
  }

  .ai-trust-badges__icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    font-size: {{ block.settings.icon_size }}px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-trust-badges__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    line-height: 1.3;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-trust-badges__list-{{ ai_gen_id }} {
      gap: {{ block.settings.row_spacing_mobile }}px;
    }

    .ai-trust-badges__icon-{{ ai_gen_id }} {
      font-size: {{ block.settings.icon_size_mobile }}px;
    }

    .ai-trust-badges__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-trust-badges-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <ul class="ai-trust-badges__list-{{ ai_gen_id }}">
    {% if block.settings.badge_1_enabled and block.settings.badge_1_text != blank %}
      <li class="ai-trust-badges__item-{{ ai_gen_id }}">
        <span class="ai-trust-badges__icon-{{ ai_gen_id }}">{{ block.settings.badge_1_icon }}</span>
        <span class="ai-trust-badges__text-{{ ai_gen_id }}">{{ block.settings.badge_1_text }}</span>
      </li>
    {% endif %}

    {% if block.settings.badge_2_enabled and block.settings.badge_2_text != blank %}
      <li class="ai-trust-badges__item-{{ ai_gen_id }}">
        <span class="ai-trust-badges__icon-{{ ai_gen_id }}">{{ block.settings.badge_2_icon }}</span>
        <span class="ai-trust-badges__text-{{ ai_gen_id }}">{{ block.settings.badge_2_text }}</span>
      </li>
    {% endif %}

    {% if block.settings.badge_3_enabled and block.settings.badge_3_text != blank %}
      <li class="ai-trust-badges__item-{{ ai_gen_id }}">
        <span class="ai-trust-badges__icon-{{ ai_gen_id }}">{{ block.settings.badge_3_icon }}</span>
        <span class="ai-trust-badges__text-{{ ai_gen_id }}">{{ block.settings.badge_3_text }}</span>
      </li>
    {% endif %}

    {% if block.settings.badge_4_enabled and block.settings.badge_4_text != blank %}
      <li class="ai-trust-badges__item-{{ ai_gen_id }}">
        <span class="ai-trust-badges__icon-{{ ai_gen_id }}">{{ block.settings.badge_4_icon }}</span>
        <span class="ai-trust-badges__text-{{ ai_gen_id }}">{{ block.settings.badge_4_text }}</span>
      </li>
    {% endif %}

    {% if block.settings.badge_5_enabled and block.settings.badge_5_text != blank %}
      <li class="ai-trust-badges__item-{{ ai_gen_id }}">
        <span class="ai-trust-badges__icon-{{ ai_gen_id }}">{{ block.settings.badge_5_icon }}</span>
        <span class="ai-trust-badges__text-{{ ai_gen_id }}">{{ block.settings.badge_5_text }}</span>
      </li>
    {% endif %}
  </ul>
</div>

