    "custom_liquid_BDTYTd": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "liquid": "<style>\n  .sss-difference {\n    margin: 20px 0 24px;\n    padding: 18px;\n    border: 1px solid rgba(0, 0, 0, 0.08);\n    border-radius: 14px;\n    background: #fafaf8;\n  }\n\n  .sss-difference__eyebrow {\n    margin: 0 0 6px;\n    font-size: 11px;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: #7a7a7a;\n    line-height: 1.2;\n  }\n\n  .sss-difference__title {\n    margin: 0 0 14px;\n    font-size: 18px;\n    line-height: 1.25;\n    font-weight: 600;\n    color: #111;\n  }\n\n  .sss-difference__grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 10px;\n  }\n\n  .sss-difference__card {\n    background: #ffffff;\n    border: 1px solid rgba(0, 0, 0, 0.06);\n    border-radius: 12px;\n    padding: 14px;\n  }\n\n  .sss-difference__icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 28px;\n    height: 28px;\n    margin-bottom: 10px;\n    border-radius: 999px;\n    background: rgba(0, 0, 0, 0.04);\n    font-size: 14px;\n    line-height: 1;\n  }\n\n  .sss-difference__heading {\n    margin: 0 0 5px;\n    font-size: 14px;\n    line-height: 1.3;\n    font-weight: 600;\n    color: #111;\n  }\n\n  .sss-difference__text {\n    margin: 0;\n    font-size: 12.5px;\n    line-height: 1.5;\n    color: #666;\n  }\n\n  .sss-difference__foot {\n    margin: 14px 0 0;\n    font-size: 12px;\n    line-height: 1.5;\n    color: #666;\n  }\n\n  @media screen and (max-width: 749px) {\n    .sss-difference {\n      padding: 15px;\n      margin: 18px 0 22px;\n    }\n\n    .sss-difference__title {\n      font-size: 16px;\n    }\n\n    .sss-difference__grid {\n      grid-template-columns: 1fr;\n      gap: 8px;\n    }\n\n    .sss-difference__card {\n      padding: 13px;\n    }\n  }\n</style>\n\n<div class=\"sss-difference\">\n  <p class=\"sss-difference__eyebrow\">Why choose us</p>\n  <h3 class=\"sss-difference__title\">The Salt Sun Sand difference</h3>\n\n  <div class=\"sss-difference__grid\">\n    <div class=\"sss-difference__card\">\n      <div class=\"sss-difference__icon\">☀️</div>\n      <p class=\"sss-difference__heading\">Outdoor-ready materials</p>\n      <p class=\"sss-difference__text\">Made for relaxed outdoor living with practical fabrics suited to everyday use.</p>\n    </div>\n\n    <div class=\"sss-difference__card\">\n      <div class=\"sss-difference__icon\">✦</div>\n      <p class=\"sss-difference__heading\">Style-led design</p>\n      <p class=\"sss-difference__text\">Thoughtfully designed to bring a soft, coastal feel to your outdoor space.</p>\n    </div>\n\n    <div class=\"sss-difference__card\">\n      <div class=\"sss-difference__icon\">🚚</div>\n      <p class=\"sss-difference__heading\">Fast local dispatch</p>\n      <p class=\"sss-difference__text\">Shipped from Brisbane so your space comes together sooner, not later.</p>\n    </div>\n\n    <div class=\"sss-difference__card\">\n      <div class=\"sss-difference__icon\">🛋️</div>\n      <p class=\"sss-difference__heading\">Easy to mix and match</p>\n      <p class=\"sss-difference__text\">Designed to pair beautifully across the collection for a more cohesive look.</p>\n    </div>\n  </div>\n\n  <p class=\"sss-difference__foot\">\n    A simple way to add comfort, texture and colour to your outdoor setting without compromising on style.\n  </p>\n</div>",
        "color_text": "",
