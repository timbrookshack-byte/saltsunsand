    "faq_KamyBY": {
      "type": "faq",
      "blocks": {
        "question_H7cC9b": {
          "type": "question",
          "settings": {
            "title": "What makes Salt Sun Sand’s outdoor décor different?",
            "text": "<p><br/>At Salt Sun Sand, our <strong>outdoor décor</strong> is designed specifically for the Australian lifestyle. From UV-resistant outdoor cushions to weatherproof wall art and sustainable rugs, each piece combines on-trend style with materials made to withstand Australia’s diverse climate.<br/><br/></p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_nqgMU9": {
          "type": "question",
          "settings": {
            "title": "Can I leave Salt Sun Sand outdoor décor outside year-round?",
            "text": "<p>Yes! Our <strong>outdoor décor collections</strong> — including cushions, rugs, wall art, and bean bags — are crafted from durable, fade-resistant materials that are water, mould, and mildew resistant. They’re built to handle sun, rain, and everything in between.<br/><br/></p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_HdrdAW": {
          "type": "question",
          "settings": {
            "title": "How can I style my outdoor area with Salt Sun Sand décor?",
            "text": "<p><br/>You can mix and match our <strong>outdoor cushions</strong>, <strong>rugs</strong>, and <strong>wall art</strong> to create a cohesive and stylish space. Use cushions for comfort, rugs to define zones, and wall art to personalise your outdoor living area — all with coordinated colours and textures that elevate your <strong>outdoor décor</strong>.<br/><br/></p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_9niKAF": {
          "type": "question",
          "settings": {
            "title": "Is your outdoor décor environmentally friendly?",
            "text": "<p><br/>Yes. Many of our <strong>outdoor décor</strong> products, including our rug collection, are made using <strong>recyclable materials</strong>, offering a more sustainable choice without compromising on design or durability.<br/><br/></p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_a3fhHm": {
          "type": "question",
          "settings": {
            "title": "Does Salt Sun Sand offer fast shipping on outdoor décor?",
            "text": "<p>Absolutely. We offer <strong>fast Australia-wide shipping</strong> on all outdoor décor items, so you can start transforming your space with stylish, functional accessories as soon as possible.<br/><br/></p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
